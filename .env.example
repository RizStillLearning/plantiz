# Copy to .env on the server and fill in real values, then:
#   docker compose up -d --build

# Get a free key at https://my.plantnet.org (My Account > Create an application)
PLANTNET_API_KEY=

# Comma-separated list of origins allowed to call the API.
# Leave empty — frontend and API share the same origin behind Caddy, so
# browser requests are same-origin and CORS doesn't come into play.
CORS_ORIGINS=

# Postgres credentials for the "db" service in docker-compose.yml.
# The app container connects to it as DATABASE_URL=...@db:5432/...
# (built automatically from these — see docker-compose.yml).
POSTGRES_USER=plantiz
POSTGRES_PASSWORD=
POSTGRES_DB=plantiz

# Secret used to sign auth JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=
