# Settings for docker-compose.yml. Copy to .env, fill in the secrets, then:
#   docker compose up -d --build

# Port NGINX listens on, on this machine.
HTTP_PORT=80

# How many FastAPI containers NGINX balances requests across.
BACKEND_REPLICAS=3

# Get a free key at https://my.plantnet.org (My Account > Create an application).
# Without it, everything except plant identification works.
PLANTNET_API_KEY=

# Leave empty: NGINX serves the site and the API from one origin.
CORS_ORIGINS=

# Postgres for the "db" service. POSTGRES_PASSWORD is required.
POSTGRES_USER=plantiz
POSTGRES_PASSWORD=
POSTGRES_DB=plantiz
POSTGRES_PORT=5432

# Signs login tokens. Required. Generate one with: openssl rand -hex 32
JWT_SECRET=
