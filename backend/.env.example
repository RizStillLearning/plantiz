# Copy to backend/.env for running the API outside Docker.

# Get a free key at https://my.plantnet.org (My Account > Create an application).
# Without it, everything except plant identification works.
PLANTNET_API_KEY=

# Origins allowed to call the API from a browser. Not needed in dev: the Vite
# dev server proxies /api, so requests are same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres, e.g. the compose "db" service (`docker compose up -d db`):
DATABASE_URL=postgresql+psycopg://plantiz:<your-postgres-password>@localhost:5432/plantiz
# Or, for quick local work, a SQLite file:
# DATABASE_URL=sqlite:///./plantiz.db

# Signs login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Largest photo accepted for identification, in MB.
MAX_UPLOAD_MB=10
