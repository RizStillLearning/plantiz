# Get a free key at https://my.plantnet.org (My Account > Create an application)
PLANTNET_API_KEY=

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres connection string. For a local Postgres started via the repo's
# docker-compose (`docker compose up -d db`), this matches whatever you set
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB to in the root .env:
DATABASE_URL=postgresql+psycopg://plantiz:<your-postgres-password>@localhost:5432/plantiz

# Secret used to sign auth JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=
